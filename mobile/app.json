{
  "expo": {
    "name": "Inklu",
    "slug": "inklu",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "inklu",
    "icon": "./assets/inklu-icon-512.png",
    "platforms": ["android", "ios", "web"],
    "android": {
      "package": "com.inklu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/inklu-icon-512.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.inklu.app"
    },
    "plugins": [
      "expo-document-picker"
    ]
  }
}
