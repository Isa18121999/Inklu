# MongoDB connection string used by the API.
MONGODB_URI=mongodb://localhost:27017/inklu

# Use a long, unique secret in every deployed environment. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Hosting providers normally inject PORT automatically.
PORT=3000

# Comma-separated list of allowed web origins.
CORS_ORIGIN=http://localhost:8081

# Google OAuth 2.0 credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://inklu-api.onrender.com/api/auth/google/callback
MOBILE_AUTH_REDIRECT_URI=inklu://auth/google

# Resend email service for password recovery.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Inklu <no-reply@your-verified-domain.com>
PASSWORD_RESET_BASE_URL=https://inklu-api.onrender.com/api/auth/reset-password
