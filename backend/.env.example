PORT=10000
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/inklu?retryWrites=true&w=majority
JWT_SECRET=
# Genera un valor nuevo y privado (mínimo 32 caracteres), por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# No inicies la API con JWT_SECRET vacío ni compartas el secreto.
FRONTEND_ORIGIN=https://TU_USUARIO.github.io

# Recuperación de contraseña (configurar en Render)
# Opción sin dominio propio: Gmail con verificación en dos pasos y contraseña de aplicación.
SMTP_USER=tu-cuenta@gmail.com
SMTP_APP_PASSWORD=contraseña_de_aplicación_de_16_caracteres
SMTP_SERVICE=gmail
# Opcional: debe coincidir con SMTP_USER al usar Gmail
EMAIL_FROM=tu-cuenta@gmail.com
# Alternativa si se verifica dominio en Resend:
RESEND_API_KEY=
PASSWORD_RESET_URL=https://isa18121999.github.io/Inklu/reset-password.html
